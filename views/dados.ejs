<%- include('./layouts/header') %>

<article class="artc2">
    <h1><%= titulo %></h1>
    <p>Esta será a página onde você irá visualizar, adicionar, editar e excluir dados.</p>

    <div class="botao-container">
        <a href="/dados/formulario" class="btn-adicionar">Adicionar Novo Post</a>
    </div>

    <h2>Postagens Recentes</h2>

    <% if (posts && posts.length > 0) { %>
        <ul style="list-style-type: none; padding: 0;">
            <% posts.forEach(post => { %>
                <li class="post-card">
                    <h3><%= post.titulo %></h3>
                    <p><b>Descrição do POST:</b></p>
                    <p class="post-conteudo"><%= post.conteudo %></p>
                    <div class="post-meta">
                        Categoria: <%= post.Categoria ? post.Categoria.nome : 'Sem categoria' %> | Autor: <%= post.Usuario ? post.Usuario.nome : 'Desconhecido' %>
                    </div>
                    <div class="item-actions">
                        <a href="/dados/formulario/<%= post.id %>" class="btn-editar">Editar</a>
                        <form action="/dados/excluir-post/<%= post.id %>" method="POST">
                            <button type="submit" class="btn-excluir" onclick="return confirm('Tem certeza que deseja excluir este post?');">Excluir</button>
                        </form>
                    </div>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>Nenhum post cadastrado ainda.</p>
    <% } %>
</article>

<%- include('./layouts/footer') %>