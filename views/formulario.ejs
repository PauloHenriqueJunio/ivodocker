<%- include('./layouts/header') %>

<article class="artc2">
    <h1><%= titulo %></h1>
    <p>Preencha os campos abaixo para adicionar ou editar um post.</p>

    <form action="<%= post ? '/dados/editar-post/' + post.id : '/dados/salvar-post' %>" method="POST">
        <div>
            <label for="titulo">Título do Post:</label>
            <input type="text" id="titulo" name="titulo" value="<%= post ? post.titulo : '' %>" required>
        </div>
        <div>
            <label for="conteudo">Conteúdo:</label>
            <textarea id="conteudo" name="conteudo" rows="8" required><%= post ? post.conteudo : '' %></textarea>
        </div>
        <div>
            <label for="categoriaId">Categoria:</label>
            <select id="categoriaId" name="categoriaId" required>
                <option value="">Selecione</option>
                <option value="1" <%= post && post.categoriaId === 1 ? 'selected' : '' %>>Esporte</option>
                <option value="2" <%= post && post.categoriaId === 2 ? 'selected' : '' %>>Tecnologia</option>
                <option value="3" <%= post && post.categoriaId === 3 ? 'selected' : '' %>>Social</option>
                <option value="4" <%= post && post.categoriaId === 4 ? 'selected' : '' %>>Educação</option>
                <option value="5" <%= post && post.categoriaId === 5 ? 'selected' : '' %>>Saúde</option>
            </select>
        </div>
        <button type="submit">Salvar</button>
        <a href="/dados">Cancelar</a>
    </form>
</article>

<%- include('./layouts/footer') %>