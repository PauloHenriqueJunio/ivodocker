<%- include('./layouts/header') %>

<article class="artc2">
    <h1><%= titulo %></h1>
    <p>Preencha os campos abaixo para adicionar ou editar um post.</p>

    <form action="<%= post ? '/dados/editar-post/' + post.id : '/dados/salvar-post' %>" method="POST">
        <div>
            <label for="titulo">Título do Post:</label>
            <input type="text" id="titulo" name="titulo" value="<%= post ? post.titulo : '' %>" required>
        </div>
        <div>
            <label for="conteudo">Conteúdo:</label>
            <textarea id="conteudo" name="conteudo" rows="8" required><%= post ? post.conteudo : '' %></textarea>
        </div>
        <div>
            <label for="categoriaId">Categoria:</label>
            <select id="categoriaId" name="categoriaId" required>
                <option value="">Selecione</option>
                <% categorias.forEach(function(cat) { %>
                    <option value="<%= cat.id %>" <%= post && post.categoriaId === cat.id ? 'selected' : '' %>><%= cat.nome %></option>
                <% }); %>
            </select>
        </div>
        <button type="submit">Salvar</button>
        <a href="/dados">Cancelar</a>
    </form>
</article>

<%- include('./layouts/footer') %>