{
    "name": "Blog Docker - Ambiente de Dev",
    "dockerComposeFile": [
        "../docker-compose.yml"
    ],

    "service": "app",
    "workspaceFolder": "/usr/src/app",

    "customizations": {
        "vscode": {
            "extensions": [
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "ms-azuretools.vscode-docker"
            ],
            "settings": {
                "emmet.includeLanguages": {
                    "ejs": "html"
                }
            }
        }
    },
    
    "postCreateCommand": "npm install"
}